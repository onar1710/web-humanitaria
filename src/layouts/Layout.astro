---
const { title = 'Misión Humanitaria', description = 'Misión Humanitaria - Servicios de salud visual, odontología y asesoría legal en Bogotá. Gafas corrientes, prótesis dentales y servicios jurídicos sin costo para población vulnerable.', image } = Astro.props;
import Header from '../components/Header.astro';
import CookieBanner from '../components/CookieBanner.astro';
import SEO from '../components/SEO.astro';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<SEO title={title} description={description} image={image} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
		<link rel="icon" href="/favicon.ico?v=2" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Poppins:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
	</head>
	<body class="bg-black text-white antialiased">
		<Header />
		<slot />
		<CookieBanner />
	</body>
</html>

<style is:global>
	:root {
		--black: #050505;
		--dark-bg: #0d1117;
		--emerald: #00b140;
		--emerald-dark: #031f14;
		--neon-green: #39ff14;
		--lime-green: #7CFF00;
		--electric-green: #00ff88;
		--purple-shadow: #240038;
		--accent-green: #00ff66;
		--accent-blue: #005eff;
		--accent-purple: #9b00ff;
		--accent-orange: #ff7a00;
	}

	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html, body {
		margin: 0;
		padding: 0;
		width: 100%;
		max-width: 100%;
		overflow-x: hidden;
		font-family: 'Inter', 'Poppins', sans-serif;
	}

	body {
		background-color: var(--black);
		color: white;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		overflow-x: hidden;
	}

	.container {
		max-width: 1280px;
		margin: 0 auto;
		padding: 0 1rem;
	}

	@media (min-width: 768px) {
		.container {
			padding: 0 2rem;
		}
	}
</style>
