---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import GreenBanner from '../components/GreenBanner.astro';
import Carousel from '../components/Carousel.astro';
import CategoriesMenu from '../components/CategoriesMenu.astro';
import BlueSection from '../components/BlueSection.astro';
import FlyerCarousel from '../components/FlyerCarousel.astro';
import StrategySection from '../components/StrategySection.astro';
import AboutUs from '../components/AboutUs.astro';
import FacebookActivities from '../components/FacebookActivities.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

const title = 'Misión Humanitaria';
const description = 'Misión Humanitaria - Servicios de salud visual, odontología y asesoría legal en Bogotá. Gafas corrientes, prótesis dentales y servicios jurídicos sin costo para población vulnerable. Ayuda humanitaria para alcaldías y empresas.';
const image = '/carrusel/jOfIq.jpg';
---

<Layout title={title} description={description} image={image}>
	<Header />
	<main>
		<GreenBanner />
		<Carousel />
		<CategoriesMenu />
		<BlueSection />
		<FlyerCarousel />
		<StrategySection />
		<AboutUs />
		<FacebookActivities />
		<Contact />
	</main>
	<div class="border-t-4 border-dashed border-[#00E814]" style="box-shadow: 0 0 10px #00E814, 0 0 20px #00E814;"></div>
	<Footer />
</Layout>
