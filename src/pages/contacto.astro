---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

const title = 'Contacto - Misión Humanitaria';
const description = 'Contáctenos - Misión Humanitaria. Llámenos al 315 881 8146 o escríbanos a gestionmisionhumanitaria@gmail.co. Estamos ubicados en Bogotá. Servicios de salud visual, odontología y asesoría legal.';
---

<Layout title={title} description={description}>
	<main class="min-h-screen bg-black text-white pt-24 py-16 px-4">
		<div class="container mx-auto max-w-6xl">
			<h1 class="text-4xl md:text-5xl font-bold mb-4 text-[#00E814] text-center">
				Contáctenos
			</h1>
			<p class="text-gray-400 mb-12 text-lg text-center">
				Estamos aquí para ayudarle. Póngase en contacto con nosotros.
			</p>

			<div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
				<!-- Información de Contacto -->
				<div class="space-y-12">
					<section>
						<h2 class="text-2xl font-bold text-white mb-6">Información de Contacto</h2>
						
						<div class="space-y-6">
							<div class="flex items-start gap-4">
								<div class="w-12 h-12 rounded-full bg-[#00E814]/20 flex items-center justify-center flex-shrink-0">
									<svg class="w-6 h-6 text-[#00E814]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
									</svg>
								</div>
								<div>
									<h3 class="font-bold text-white mb-1">Teléfono</h3>
									<p class="text-gray-300">315 881 8146</p>
									<p class="text-gray-400 text-sm">Lunes a Viernes: 8:00 AM - 6:00 PM</p>
								</div>
							</div>

							<div class="flex items-start gap-4">
								<div class="w-12 h-12 rounded-full bg-[#00E814]/20 flex items-center justify-center flex-shrink-0">
									<svg class="w-6 h-6 text-[#00E814]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
									</svg>
								</div>
								<div>
									<h3 class="font-bold text-white mb-1">Correo Electrónico</h3>
									<p class="text-gray-300">info@misionhumanitaria.org</p>
									<p class="text-gray-400 text-sm">Respondemos en 24-48 horas</p>
								</div>
							</div>

							<div class="flex items-start gap-4">
								<div class="w-12 h-12 rounded-full bg-[#00E814]/20 flex items-center justify-center flex-shrink-0">
									<svg class="w-6 h-6 text-[#00E814]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
									</svg>
								</div>
								<div>
									<h3 class="font-bold text-white mb-1">Dirección</h3>
									<p class="text-gray-300">Bogotá, Colombia</p>
									<p class="text-gray-400 text-sm">Zona urbana</p>
								</div>
							</div>

							<div class="flex items-start gap-4">
								<div class="w-12 h-12 rounded-full bg-[#00E814]/20 flex items-center justify-center flex-shrink-0">
									<svg class="w-6 h-6 text-[#00E814]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
									</svg>
								</div>
								<div>
									<h3 class="font-bold text-white mb-1">NIT</h3>
									<p class="text-gray-300">830123548-3</p>
								</div>
							</div>
						</div>
					</section>

					<section>
						<h2 class="text-2xl font-bold text-white mb-6">Síganos en Redes Sociales</h2>
						<div class="grid grid-cols-2 gap-4">
							<a 
								href="https://www.facebook.com/share/1E2kDuYD5t/" 
								target="_blank" 
								rel="noopener noreferrer"
								class="flex items-center gap-3 p-4 bg-black rounded-xl border border-[#00E814]/30 hover:border-[#00E814] transition-colors"
							>
								<svg class="w-8 h-8 text-[#00E814]" fill="currentColor" viewBox="0 0 24 24">
									<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
								</svg>
								<span class="text-white font-medium">Facebook</span>
							</a>
							<a 
								href="https://www.linkedin.com/in/fundación-misión-humanitaria-construir-529408348?utm_source=share_via&utm_content=profile&utm_medium=member_android" 
								target="_blank" 
								rel="noopener noreferrer"
								class="flex items-center gap-3 p-4 bg-black rounded-xl border border-[#00E814]/30 hover:border-[#00E814] transition-colors"
							>
								<svg class="w-8 h-8 text-[#00E814]" fill="currentColor" viewBox="0 0 24 24">
									<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
								</svg>
								<span class="text-white font-medium">LinkedIn</span>
							</a>
							<a 
								href="https://www.tiktok.com/@mision.humanitari?_r=1&_t=ZS-96ZyD2HoiOL" 
								target="_blank" 
								rel="noopener noreferrer"
								class="flex items-center gap-3 p-4 bg-black rounded-xl border border-[#00E814]/30 hover:border-[#00E814] transition-colors"
							>
								<svg class="w-8 h-8 text-[#00E814]" fill="currentColor" viewBox="0 0 24 24">
									<path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 2.86-5.91 2.24-1.43-.39-2.72-1.44-3.45-2.77-.84-1.56-.93-3.49-.35-5.16.59-1.72 1.93-3.08 3.63-3.66 1.34-.44 2.79-.27 4.03.43.01 1.35.02 2.69.04 4.04-.71-.35-1.52-.56-2.33-.47-.87.09-1.67.66-2.06 1.44-.41.84-.27 1.9.32 2.64.59.74 1.56 1.07 2.42.75.83-.31 1.35-1.17 1.33-2.06-.02-1.33-.02-2.66-.01-3.99-.01-1.76-.01-3.52-.01-5.28z"/>
								</svg>
								<span class="text-white font-medium">TikTok</span>
							</a>
							<a 
								href="https://www.instagram.com/mision.humanitaria?utm_source=qr&igsh=MWJjejltOWpwMDV2aw==" 
								target="_blank" 
								rel="noopener noreferrer"
								class="flex items-center gap-3 p-4 bg-black rounded-xl border border-[#00E814]/30 hover:border-[#00E814] transition-colors"
							>
								<svg class="w-8 h-8 text-[#00E814]" fill="currentColor" viewBox="0 0 24 24">
									<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
								</svg>
								<span class="text-white font-medium">Instagram</span>
							</a>
						</div>
					</section>

					<section>
						<h2 class="text-2xl font-bold text-white mb-4">Contáctenos por WhatsApp</h2>
						<p class="text-gray-300 mb-6">
							Para una respuesta más rápida, escríbanos directamente por WhatsApp.
						</p>
						<a 
							href="https://wa.me/3158818146" 
							target="_blank" 
							rel="noopener noreferrer"
							class="inline-flex items-center gap-3 bg-[#25D366] text-white px-6 py-4 rounded-xl font-bold hover:bg-[#128C7E] transition-colors"
						>
							<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
								<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
							</svg>
							Escríbenos al WhatsApp
						</a>
					</section>
				</div>

				<!-- Formulario de Contacto -->
				<div>
					<h2 class="text-2xl font-bold text-white mb-6">Envíenos un Mensaje</h2>
					<form 
						id="contactForm"
						class="space-y-6"
					>
						<div>
							<label for="nombre" class="block text-white font-medium mb-2">Nombre Completo *</label>
							<input 
								type="text" 
								id="nombre" 
								name="nombre" 
								required
								class="w-full px-4 py-3 bg-black border border-[#00E814]/30 rounded-xl text-white placeholder-gray-500 focus:outline-none focus:border-[#00E814] transition-colors"
								placeholder="Ingrese su nombre completo"
							/>
						</div>

						<div>
							<label for="email" class="block text-white font-medium mb-2">Correo Electrónico *</label>
							<input 
								type="email" 
								id="email" 
								name="email" 
								required
								class="w-full px-4 py-3 bg-black border border-[#00E814]/30 rounded-xl text-white placeholder-gray-500 focus:outline-none focus:border-[#00E814] transition-colors"
								placeholder="ejemplo@correo.com"
							/>
						</div>

						<div>
							<label for="telefono" class="block text-white font-medium mb-2">Teléfono</label>
							<input 
								type="tel" 
								id="telefono" 
								name="telefono"
								class="w-full px-4 py-3 bg-black border border-[#00E814]/30 rounded-xl text-white placeholder-gray-500 focus:outline-none focus:border-[#00E814] transition-colors"
								placeholder="315 881 8146"
							/>
						</div>

						<div>
							<label for="asunto" class="block text-white font-medium mb-2">Asunto *</label>
							<select 
								id="asunto" 
								name="asunto" 
								required
								class="w-full px-4 py-3 bg-black border border-[#00E814]/30 rounded-xl text-white focus:outline-none focus:border-[#00E814] transition-colors"
							>
								<option value="">Seleccione un asunto</option>
								<option value="servicios">Información sobre servicios</option>
								<option value="citas">Agendar cita</option>
								<option value="empresas">Servicios para empresas</option>
								<option value="legal">Asesoría legal</option>
								<option value="contable">Asesoría contable</option>
								<option value="otro">Otro</option>
							</select>
						</div>

						<div>
							<label for="mensaje" class="block text-white font-medium mb-2">Mensaje *</label>
							<textarea 
								id="mensaje" 
								name="mensaje" 
								rows="5" 
								required
								class="w-full px-4 py-3 bg-black border border-[#00E814]/30 rounded-xl text-white placeholder-gray-500 focus:outline-none focus:border-[#00E814] transition-colors resize-none"
								placeholder="Escriba su mensaje aquí..."
							></textarea>
						</div>

						<button 
							type="submit"
							id="submitBtn"
							class="w-full bg-[#00E814] text-black px-6 py-4 rounded-xl font-bold hover:bg-[#00C412] transition-colors"
						>
							Enviar Mensaje
						</button>

						<p class="text-gray-400 text-sm text-center">
							Los campos marcados con * son obligatorios
						</p>
					</form>
					
					<!-- Alerta de éxito -->
					<div id="successAlert" class="hidden mt-4 p-4 bg-green-500/20 border border-green-500 rounded-xl">
						<p class="text-green-400 text-center font-medium">¡Mensaje enviado con éxito!</p>
					</div>
					
					<!-- Alerta de error -->
					<div id="errorAlert" class="hidden mt-4 p-4 bg-red-500/20 border border-red-500 rounded-xl">
						<p class="text-red-400 text-center font-medium">Error al enviar el mensaje. Por favor, inténtelo nuevamente.</p>
					</div>
				</div>
			</div>

			<!-- Mapa -->
			<section class="mt-12">
				<h2 class="text-2xl font-bold text-white mb-6">Nuestra Ubicación</h2>
				<div class="aspect-video bg-black rounded-xl overflow-hidden border border-[#00E814]/30">
					<iframe 
						src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3976.9385784287!2d-74.072092!3d4.710989!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zM4LjcxMDk5LC03NC4wNzIwOTIgQm9nb3TDsSwgQ29sb21iaWE!5e0!3m2!1ses!2sco!4v1700000000000!5m2!1ses!2sco" 
						width="100%" 
						height="100%" 
						style="border:0;" 
						allowfullscreen="" 
						loading="lazy" 
						referrerpolicy="no-referrer-when-downgrade"
						class="w-full h-full"
					></iframe>
				</div>
				<p class="text-gray-300 mt-4 text-center">
					Bogotá, Colombia
				</p>
			</section>
		</div>
	</main>
	<Footer />

	<script>
		document.addEventListener('DOMContentLoaded', () => {
			const contactForm = document.getElementById('contactForm');
			if (!contactForm) return;
			
			contactForm.addEventListener('submit', async function(e) {
			e.preventDefault();
			
			const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
			const successAlert = document.getElementById('successAlert');
			const errorAlert = document.getElementById('errorAlert');
			
			if (!submitBtn || !successAlert || !errorAlert) return;
			
			// Deshabilitar botón
			submitBtn.disabled = true;
			submitBtn.textContent = 'Enviando...';
			
			// Ocultar alertas anteriores
			successAlert.classList.add('hidden');
			errorAlert.classList.add('hidden');
			
			// Recopilar datos del formulario
			const formData = new FormData(this as HTMLFormElement);
			const data: Record<string, string> = {};
			formData.forEach((value, key) => {
				data[key] = value.toString();
			});
			
			try {
				const response = await fetch('https://formspree.io/f/xlgvvjzj', {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json',
						'Accept': 'application/json'
					},
					body: JSON.stringify(data)
				});
				
				if (response.ok) {
					// Mostrar alerta de éxito
					successAlert.classList.remove('hidden');
					(this as HTMLFormElement).reset();
				} else {
					// Mostrar alerta de error
					errorAlert.classList.remove('hidden');
				}
			} catch (error) {
				// Mostrar alerta de error
				errorAlert.classList.remove('hidden');
			} finally {
				// Rehabilitar botón
				submitBtn.disabled = false;
				submitBtn.textContent = 'Enviar Mensaje';
			}
		});
		});
	</script>
</Layout>
