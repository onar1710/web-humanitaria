	{ name: 'Asesoría Legal', icon: 'M12 2L1 21h22L12 2zm0 3.99L19.53 19H4.47L12 5.99zM11 16h2v2h-2zm0-6h2v4h-2z' },
	{ name: 'Salud', icon: 'M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z' },
	{ name: 'Asesoria Contable', icon: 'M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z' },
	{ name: 'Hábitos Saludables', icon: 'M13.49 5.48c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm-3.6 13.9l1-4.4 2.1 2v6h2v-7.5l-2.1-2 .6-3c1.3 1.5 3.3 2.5 5.5 2.5v-2c-1.9 0-3.5-1-4.3-2.4l-1-1.6c-.4-.6-1-1-1.7-1-.3 0-.5.1-.8.1l-5.2 2.2v4.7h2v-3.4l1.8-.7-1.6 8.1-4.9-1-.4 2 7 1.4z' },
	{ name: 'Capacitacion', icon: 'M12 3L1 9l4 2.18v6L12 21l7-3.82v-6l2-1.09V17h2V9L12 3zm6.82 6L12 12.72 5.18 9 12 5.28 18.82 9zM17 15.99l-5 2.73-5-2.73v-3.72L12 15l5-2.73v3.72z' },
	{ name: 'Cuidados', icon: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z' },
	{ name: 'Consultoria', icon: 'M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H6l-2 2V4h16v12z' },
];
---

<div class="flex flex-nowrap justify-center gap-6 md:gap-10 overflow-hidden py-10" id="categoriesTrack">
	{categories.map((category) => (
		<div class="flex flex-col items-center gap-3 flex-shrink-0">
			<!-- Círculo con borde glow verde neón -->
			<div class="w-24 h-24 md:w-20 md:h-20 rounded-full border-2 flex items-center justify-center shadow-[0_0_10px_rgba(0,255,0,0.4),0_0_20px_rgba(0,255,0,0.3),0_0_30px_rgba(0,255,0,0.2)]" style="border-color: #00FF00; background: transparent;">
				<svg class="w-12 h-12 md:w-10 md:h-10 drop-shadow-[0_0_5px_rgba(0,255,0,0.4)]" fill="currentColor" viewBox="0 0 24 24" style="color: #00FF00;">
					<path d={category.icon} />
				</svg>
			</div>
			<!-- Nombre de la categoría -->
			<span class="text-xs md:text-sm font-semibold text-center max-w-22 drop-shadow-[0_0_4px_rgba(0,255,0,0.4)]" style="color: #00FF00;">
				{category.name}
			</span>
		</div>
	))}
</div>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const track = document.getElementById('categoriesTrack');
		if (!track) return;

		let scrollPosition = 0;
		const scrollSpeed = 0.3;
		let isRunning = true;
		let animationId;

		const scrollCategories = () => {
			if (!isRunning) return;
			scrollPosition += scrollSpeed;
			const maxScroll = track.scrollWidth - track.clientWidth;
			
			if (scrollPosition >= maxScroll) {
				scrollPosition = 0;
			}
			
			track.scrollLeft = scrollPosition;
			animationId = requestAnimationFrame(scrollCategories);
		};

		// Pausar cuando el mouse está sobre el carrusel
		track.addEventListener('mouseenter', () => {
			isRunning = false;
		});

		track.addEventListener('mouseleave', () => {
			isRunning = true;
		});

		// Pausar cuando el usuario hace scroll en la página
		let isPageScrolling = false;
		let scrollTimeout;

		window.addEventListener('scroll', () => {
			isPageScrolling = true;
			isRunning = false;
			
			clearTimeout(scrollTimeout);
			scrollTimeout = setTimeout(() => {
				isPageScrolling = false;
				isRunning = true;
			}, 500);
		});

		// Iniciar el carrusel automático
		scrollCategories();
	});
</script>
