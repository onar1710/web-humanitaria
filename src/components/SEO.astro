---
export interface Props {
	title: string;
	description: string;
	image?: string;
	canonical?: string;
	type?: 'website' | 'article';
	noindex?: boolean;
	article?: {
		publishedTime?: string;
		modifiedTime?: string;
		author?: string;
		section?: string;
		tags?: string[];
	};
	organization?: {
		name?: string;
		logo?: string;
		address?: {
			streetAddress?: string;
			addressLocality?: string;
			addressRegion?: string;
			postalCode?: string;
			addressCountry?: string;
		};
		contactPoint?: {
			telephone?: string;
			email?: string;
			contactType?: string;
		};
	};
}

const {
	title,
	description,
	image = '/og-image.jpg',
	canonical = new URL(Astro.url.pathname, Astro.site).href,
	type = 'website',
	noindex = false,
	article,
	organization
} = Astro.props;

const siteName = 'Misión Humanitaria';
const fullTitle = `${title} | ${siteName}`;
const siteUrl = 'https://www.misionhumanitaria.org';
const fullImage = image.startsWith('http') ? image : `${siteUrl}${image}`;
const fullCanonical = canonical.startsWith('http') ? canonical : `${siteUrl}${canonical}`;

// Organization data for Schema
const orgName = organization?.name || 'Misión Humanitaria';
const orgLogo = organization?.logo || `${siteUrl}/favicon.svg`;
const orgAddress = organization?.address || {
	streetAddress: '',
	addressLocality: 'Bogotá',
	addressRegion: 'DC',
	postalCode: '',
	addressCountry: 'CO'
};
const orgContact = organization?.contactPoint || {
	telephone: '+57 315 881 8146',
	email: 'gestionmisionhumanitaria@gmail.co',
	contactType: 'customer service'
};
---

<!-- Meta Tags Básicos -->
<meta name="description" content={description} />
<meta name="keywords" content="misión humanitaria, salud visual, odontología, asesoría legal, bogotá, ayuda humanitaria, gafas, prótesis dentales, servicios jurídicos" />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={fullCanonical} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={fullTitle} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="es_CO" />
{type === 'article' && article && (
	<>
		<meta property="article:published_time" content={article.publishedTime || ''} />
		<meta property="article:modified_time" content={article.modifiedTime || ''} />
		<meta property="article:author" content={article.author || ''} />
		<meta property="article:section" content={article.section || ''} />
		{article.tags && article.tags.map(tag => <meta property="article:tag" content={tag} />)}
	</>
)}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={fullCanonical} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullImage} />
<meta name="twitter:image:alt" content={fullTitle} />
<meta name="twitter:site" content="@misionhumanitaria" />
<meta name="twitter:creator" content="@misionhumanitaria" />

<!-- Canonical URL -->
<link rel="canonical" href={fullCanonical} />

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

<!-- Additional SEO -->
<meta name="author" content="Misión Humanitaria" />
<meta name="theme-color" content="#00E814" />
<meta name="msapplication-TileColor" content="#00E814" />

<!-- Schema.org JSON-LD -->
<script type="application/ld+json" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": type === 'article' ? 'Article' : 'Organization',
	"name": type === 'article' ? fullTitle : orgName,
	"url": fullCanonical,
	"description": description,
	"image": fullImage,
	"logo": orgLogo,
	"address": {
		"@type": "PostalAddress",
		"streetAddress": orgAddress.streetAddress,
		"addressLocality": orgAddress.addressLocality,
		"addressRegion": orgAddress.addressRegion,
		"postalCode": orgAddress.postalCode,
		"addressCountry": orgAddress.addressCountry
	},
	"contactPoint": {
		"@type": "ContactPoint",
		"telephone": orgContact.telephone,
		"email": orgContact.email,
		"contactType": orgContact.contactType,
		"areaServed": "CO",
		"availableLanguage": "Spanish"
	},
	"sameAs": [
		"https://www.facebook.com/misionhumanitaria",
		"https://www.instagram.com/misionhumanitaria",
		"https://www.linkedin.com/company/misionhumanitaria",
		"https://www.tiktok.com/@misionhumanitaria"
	],
	...(type === 'article' && article ? {
		"author": {
			"@type": "Organization",
			"name": article.author || orgName
		},
		"datePublished": article.publishedTime,
		"dateModified": article.modifiedTime,
		"publisher": {
			"@type": "Organization",
			"name": orgName,
			"logo": orgLogo
		}
	} : {})
})} />
