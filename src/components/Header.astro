---
const menuItems = [
	{ name: 'Servicios', href: '#servicios' },
	{ name: 'Actividades', href: '#actividades' },
	{ name: 'Contacto', href: '#contacto' },
];

const services = [
	'VALORACIÓN VISUAL',
	'VALORACIÓN ODONTOLÓGICA',
	'ASESORÍA LEGAL',
	'MISIÓN HUMANITARIA',
];
---

<!-- White Bar -->
<div class="fixed top-0 left-0 right-0 h-12 border-b-4 border-red-600 shadow-lg z-40 overflow-hidden bg-white">
	<div class="h-full flex items-center">
		<div class="animate-marquee whitespace-nowrap">
			{services.map((service) => (
				<span class="inline-block mx-8 font-semibold text-xl uppercase" style="color: #0D00FF;">
					{service}
				</span>
			))}
			{services.map((service) => (
				<span class="inline-block mx-8 font-semibold text-xl uppercase" style="color: #0D00FF;">
					{service}
				</span>
			))}
		</div>
	</div>
</div>

<style>
	@keyframes marquee {
		0% {
			transform: translateX(0);
		}
		100% {
			transform: translateX(-50%);
		}
	}
	.animate-marquee {
		animation: marquee 20s linear infinite;
	}
</style>

<header class="fixed top-12 left-0 right-0 z-50 bg-white/95 backdrop-blur-md border-b border-emerald-500/30">
	<nav class="container mx-auto px-4 py-24">
		<div class="flex items-center justify-between gap-4">
			<a href="/" class="flex items-center gap-2 group flex-shrink-0">
				<div class="w-16 h-16 flex items-center justify-center group-hover:scale-110 transition-all duration-300 p-2">
					<svg class="w-16 h-16" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
						<!-- Círculo rojo -->
						<circle cx="50" cy="50" r="45" fill="red" stroke="red" stroke-width="2"/>
						<!-- Cruz blanca -->
						<path d="M35 10 L65 10 L65 35 L90 35 L90 65 L65 65 L65 90 L35 90 L35 65 L10 65 L10 35 L35 35 Z" fill="white"/>
					</svg>
				</div>
				<span class="font-bold text-lg group-hover:opacity-80 transition-opacity bg-gradient-to-r from-green-500 to-black bg-clip-text text-transparent">Misión Humanitaria</span>
			</a>

			<!-- Search Bar -->
			<div class="flex-1 max-w-xs mx-4 hidden md:block">
				<div class="relative">
					<input 
						type="text" 
						placeholder="Buscar..." 
						class="w-full px-3 py-2 pr-9 bg-gray-100 border border-emerald-500 rounded-lg text-black placeholder-gray-500 focus:outline-none focus:border-emerald-600 focus:ring-2 focus:ring-emerald-500/20 transition-all"
					/>
					<svg class="absolute right-2.5 top-1/2 transform -translate-y-1/2 w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
					</svg>
				</div>
			</div>

			<!-- Desktop Menu -->
			<ul class="hidden md:flex items-center gap-6 flex-shrink-0">
				{menuItems.map((item) => (
					<li>
						<a 
							href={item.href} 
							class="text-black font-medium hover:text-emerald-600 transition-colors relative group"
						>
							{item.name}
							<span class="absolute bottom-0 left-0 w-0 h-0.5 bg-emerald-600 group-hover:w-full transition-all duration-300"></span>
						</a>
					</li>
				))}
			</ul>

			<!-- Mobile Icons -->
			<div class="md:hidden flex items-center gap-2">
				<!-- Mobile Search Button -->
				<button onclick="document.getElementById('mobileSearchModal').classList.toggle('hidden')" class="text-black hover:text-emerald-600 transition-colors flex-shrink-0">
					<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
					</svg>
				</button>

				<!-- Mobile Menu Button -->
				<button class="text-black hover:text-emerald-600 transition-colors flex-shrink-0">
					<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
					</svg>
				</button>
			</div>
		</div>
	</nav>
</header>

<!-- Mobile Search Modal -->
<div id="mobileSearchModal" class="hidden fixed top-24 left-0 right-0 z-50 bg-white border-b border-emerald-500/30 p-4 shadow-lg md:hidden">
	<div class="relative">
		<input 
			type="text" 
			placeholder="Buscar..." 
			class="w-full px-4 py-3 pr-12 bg-gray-100 border border-emerald-500 rounded-lg text-black placeholder-gray-500 focus:outline-none focus:border-emerald-600 focus:ring-2 focus:ring-emerald-500/20 transition-all"
		/>
		<button onclick="document.getElementById('mobileSearchModal').classList.add('hidden')" class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-500 hover:text-gray-700">
			<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
			</svg>
		</button>
	</div>
</div>
